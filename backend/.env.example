# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB (Running locally on your machine):
MONGO_URI=mongodb://localhost:27017/budgetbuddy

# For Cloud MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/budgetbuddy?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
